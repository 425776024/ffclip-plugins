
    uniform shader inputTexture;
    uniform shader maskTexture;
    uniform float2 textureSize;
    uniform float2 textOrigin;
    uniform float2 textExtent;
    uniform float2 authoredRtSize;
    uniform float cutPosition;
    uniform float angleRadians;
    uniform float lineHalfWidth;
    uniform float maskUvScale;
    uniform float outsideMaskStrength;
    uniform float falloffPower;

    float2 rotatePoint(float2 point, float radians) {
      float sine = sin(radians);
      float cosine = cos(radians);
      return float2(cosine * point.x + sine * point.y,
                    -sine * point.x + cosine * point.y);
    }

    half4 main(float2 position) {
      // The source pass draws the text quad into a screen-sized target.
      float2 uv = (position - textOrigin) / textExtent;
      if (any(lessThan(uv, float2(0.0))) ||
          any(greaterThan(uv, float2(1.0)))) return half4(0.0);
      float2 maskUv = uv - float2(0.5);
      maskUv.x *= authoredRtSize.x / max(authoredRtSize.y, 0.0001);
      maskUv /= max(maskUvScale, 0.0001);
      maskUv += float2(0.5);
      float mask = maskTexture.eval(maskUv * textureSize).r;
      float2 rotated = rotatePoint(
          uv - float2(0.5), angleRadians) +
          float2(0.5);
      float beam = smoothstep(lineHalfWidth, 0.0,
                              abs(rotated.x - cutPosition));
      beam = pow(max(beam, 0.0), max(falloffPower, 0.0001));
      float strength = mask + (1.0 - mask) * outsideMaskStrength;
      return half4(inputTexture.eval(uv * textureSize) * beam * strength);
    }
  
