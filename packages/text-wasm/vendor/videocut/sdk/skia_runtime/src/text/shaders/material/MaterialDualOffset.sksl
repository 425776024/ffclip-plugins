uniform shader inputTexture;
uniform float2 textureSize;
uniform float aspectRatio;
uniform float maskScale;
uniform float rotationDegrees;
uniform float2 panning;
uniform float2 offset0;
uniform float2 offset1;
uniform float alpha0;
uniform float alpha1;

half4 main(float2 position) {
    // The source quad's lower vertices already have texcoord.y=1. Its
    // vertex shader flips that to bottom-left UV for the mask and offsets.
    float2 uv = float2(position.x / textureSize.x,
                       1.0 - position.y / textureSize.y);
    float2 axisScale = aspectRatio >= 1.0 ? float2(aspectRatio, 1.0)
                                         : float2(1.0, 1.0 / aspectRatio);
    float2 point = uv * axisScale - panning * axisScale;
    float angle = radians(-rotationDegrees);
    point = float2(cos(angle) * point.x - sin(angle) * point.y,
                   sin(angle) * point.x + cos(angle) * point.y);
    point /= float2(3.0, maskScale);
    point = (point + 0.5 * axisScale) / axisScale;
    float mask = step(0.0, point.x) * step(point.x, 1.0) *
                 step(0.0, point.y) * step(point.y, 1.0);
    float2 firstUv = uv + offset0;
    float2 secondUv = uv + offset1;
    float4 first = float4(inputTexture.eval(
        float2(firstUv.x, 1.0 - firstUv.y) * textureSize)) * alpha0;
    float4 second = float4(inputTexture.eval(
        float2(secondUv.x, 1.0 - secondUv.y) * textureSize)) * alpha1;
    return half4(mix(first, second, mask));
}
