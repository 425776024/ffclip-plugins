
    uniform shader glowTexture;
    uniform shader sourceTexture;
    uniform float2 textureSize;
    uniform float blendMode;
    uniform float tint;
    uniform float tintMode;
    uniform float3 tintColor;
    uniform float tintMix;
    uniform float sourceOpacity;

    float overlayChannel(float background, float foreground) {
      return background < 0.5
          ? (2.0 * background) * foreground
          : 1.0 - ((2.0 * (1.0 - background)) *
                   (1.0 - foreground));
    }

    float3 softLight(float3 background, float3 foreground) {
      return ((float3(1.0) - float3(2.0) * foreground) *
              pow(background, float3(2.0))) +
             ((float3(2.0) * foreground) * background);
    }

    float3 screen(float3 background, float3 foreground) {
      return float3(1.0) -
             (float3(1.0) - background) *
             (float3(1.0) - foreground);
    }

    float4 blend(float4 background, float4 foreground) {
      float3 color = blendMode < 0.5
          ? screen(background.rgb, foreground.rgb)
          : min(background.rgb + foreground.rgb, float3(1.0));
      float alpha = background.a + foreground.a -
                    background.a * foreground.a;
      return float4(color, alpha);
    }

    float4 main(float2 xy) {
      float2 uv = xy / textureSize;
      float4 glow = float4(glowTexture.eval(
          clamp(uv, float2(0.0), float2(1.0)) * textureSize));
      float4 source = float4(sourceTexture.eval(
          clamp(uv, float2(0.0), float2(1.0)) * textureSize));
      if (tint >= 0.5) {
        float4 tinted = glow;
        if (tintMode < 0.5) {
          tinted.rgb = tintColor * dot(
              glow.rgb,
              float3(0.2989999949932098388671875,
                     0.58700001239776611328125,
                     0.114000000059604644775390625));
        } else if (tintMode < 1.5) {
          tinted.rgb = glow.rgb * tintColor;
        } else if (tintMode < 2.5) {
          tinted.rgb = float3(
              overlayChannel(glow.r, tintColor.r),
              overlayChannel(glow.g, tintColor.g),
              overlayChannel(glow.b, tintColor.b));
        } else {
          glow.rgb = min(glow.rgb, float3(1.0));
          tinted.rgb = softLight(glow.rgb, tintColor);
        }
        glow = mix(glow, tinted, float4(tintMix));
      }
      float maximum = max(max(glow.r, glow.g), glow.b);
      glow = maximum > 0.0 ? float4(glow.rgb, maximum) : float4(0.0);
      return mix(glow, blend(source, glow), float4(sourceOpacity));
    }
  