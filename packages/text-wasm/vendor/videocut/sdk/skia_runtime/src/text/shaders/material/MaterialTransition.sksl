
    uniform shader inputTexture;
    uniform float2 textureSize;
    uniform float2 direction;
    uniform float blurStep;
    uniform float percent;
    uniform float transition;
    uniform float opacity;
    half4 main(float2 position) {
      float2 normalizedDirection = normalize(direction);
      float4 color;
      if (blurStep <= 0.0) {
        color = float4(inputTexture.eval(position));
      } else {
        color = float4(0.0);
        for (int index = -25; index <= 25; ++index) {
          color += float4(inputTexture.eval(
              position + normalizedDirection * blurStep * float(index)));
        }
        color /= 51.0;
      }
      float rangeBegin = percent * (1.0 + transition) - transition;
      float rangeEnd = percent * (1.0 + transition);
      float reveal = 0.0;
      if (position.x / textureSize.x < rangeBegin) {
        reveal = 1.0;
      } else if (position.x / textureSize.x < rangeEnd && transition > 0.0) {
        reveal = smoothstep(
            0.0, 1.0,
            1.0 - (position.x / textureSize.x - rangeBegin) / transition);
      }
      return half4(color * reveal * min(opacity, 1.0));
    }
  