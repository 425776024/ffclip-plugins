
    uniform shader inputTexture;
    uniform float2 textureSize;
    uniform float2 lineToLetterRatio;
    uniform float phase;
    uniform float quantizedTime;
    uniform float passIndex;

    half4 main(float2 position) {
      float2 uv = float2(position.x / textureSize.x,
                         1.0 - position.y / textureSize.y);
      float2 sampleUv = uv;
      if (passIndex < 0.5) {
        float p = phase - 0.1;
        float2 noise = fract((float2(84301.3, 39813.7) + quantizedTime) * uv);
        float envelope = sin(p + 1.0) * sin(p + 1.5);
        float x = sin(cos(uv.x * uv.y * 7.7 + 71.0) * 68.0 + 21.0 * p) *
                  0.5 * envelope;
        float y = cos(sin((1.0 - uv.y) * uv.x * 6.7 + 43.0) * 59.0 +
                      25.0 * p) * 1.7 * envelope;
        sampleUv.y += 0.5 * mix(x, y, 0.5) / lineToLetterRatio.y *
                      0.003 * (1.0 + noise.y * 0.3) * 0.7;
        x = sin(cos(uv.y * uv.x * 4.3 + 2.87) * 49.0 + 55.0 * p) *
            0.7 * envelope;
        y = cos(sin(uv.y * (1.0 - uv.x) * 5.3 + 2.0) * 45.0 + 51.0 * p) *
            0.5 * envelope;
        sampleUv.x += 0.5 * mix(x, y, 0.5) / lineToLetterRatio.x *
                      0.003 * (1.0 + noise.x * 0.3) * 0.7;
      } else if (passIndex < 1.5) {
        float p = phase - 0.1;
        float envelope = sin(p + 0.9) * sin(p + 1.3);
        float x = sin(cos(uv.x * uv.y * 2.3 + 71.0) * 35.0 + 21.0 * p + 1.0) *
                  1.5 * envelope;
        float y = cos(sin((1.0 - uv.y) * uv.x * 3.3 + 43.0) * 35.0 +
                      25.0 * p + 2.0) * 2.5 * envelope;
        sampleUv.y += 0.5 * mix(x, y, 0.5) * 0.003 * 0.7 * 0.7;
        x = sin(cos((1.0 - uv.y) * uv.x * 2.3 + 2.87) * 35.0 +
                25.0 * p + 3.0) * 1.5 * envelope;
        y = cos(sin(uv.y * (1.0 - uv.x) * 3.3 + 2.0) * 25.0 +
                21.0 * p + 4.0) * 1.8 * envelope;
        sampleUv.x += 0.5 * mix(x, y, 0.5) * 0.003 * 0.7 * 0.7;
      } else {
        float p = fract(phase * 4.0) - 0.1;
        float envelope = 100.0 * sin(p + 1.2) * sin(p + 1.4);
        float x = sin(cos(uv.x * uv.y * 2.0 + 1.97) * 15.0 + 11.0 * p) * envelope;
        float y = cos(sin((1.0 - uv.y) * uv.x * 2.0 + 3.0) * 15.0 +
                      15.0 * p) * envelope;
        sampleUv.y += 0.225 * mix(x, y, 0.5) * 0.003 * 0.01;
        x = sin(cos(uv.y * uv.x * 2.0 + 2.87) * 15.0 + 15.0 * p) * envelope;
        y = cos(sin(uv.y * (1.0 - uv.x) * 2.0 + 2.0) * 15.0 + 11.0 * p) * envelope;
        sampleUv.x += 0.225 * mix(x, y, 0.5) * 0.003 * 0.01;
      }
      return inputTexture.eval(float2(sampleUv.x, 1.0 - sampleUv.y) * textureSize);
    }
  
