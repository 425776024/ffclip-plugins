uniform shader inputTexture;
uniform float2 textureSize;
uniform float2 viewportSize;
uniform float2 pixelOrigin;
uniform float2 pixelScale;
uniform float2 expandSize;
uniform float3 inverseModelRowX;
uniform float3 inverseModelRowY;
uniform float progress;
uniform float textLength;

float4 sampleSource(float2 point) { return float4(inputTexture.eval(point)); }

    float scatterRandom1(float value) {
      value = fract(value * 0.1031);
      value *= value + 33.33;
      value *= value + value;
      return fract(value);
    }
    float2 scatterRandom2(float value) {
      float3 p = fract(float3(value) * float3(0.1031, 0.1030, 0.0973));
      p += dot(p, p.yzx + 33.33);
      return fract((p.xx + p.yz) * p.zy);
    }
    float4 scatterCopy(float seed, float2 screenUv) {
      float p = fract(progress + scatterRandom1(seed * 24.556));
      float randomScale = scatterRandom1(seed * 4.0) * 0.95 + 0.2;
      float2 start = scatterRandom2(seed);
      start.y *= 0.5;
      float2 target = float2(
          start.x + (scatterRandom1(seed * 33.0) * 2.0 - 1.0) * 0.1,
          (start.y + scatterRandom1(seed * 21.0) * 0.6 + 0.2) *
              max(viewportSize.x / viewportSize.y, 1.0));
      float2 center = mix(start, target, p);
      float2 uv = (screenUv - center) * viewportSize /
                  (expandSize + 0.001) / randomScale * 4.0 /
                  (max(viewportSize.x, viewportSize.y) / 720.0) + center;
      if (uv.x < 0.0 || uv.y < 0.0 || uv.x > 1.0 || uv.y > 1.0)
        return float4(0.0);
      float alpha = smoothstep(0.0, scatterRandom1(seed + 13.0) * 0.2 + 0.1, p);
      if (p > 0.5)
        alpha = smoothstep(1.0, scatterRandom1(seed * 21.0) * 0.3 + 0.69, p);
      return sampleSource(float2(uv.x, 1.0 - uv.y) * textureSize) * alpha;
    }


half4 main(float2 position) {
    if (textLength < 0.5) return half4(0.0);
    float2 screen = (pixelOrigin + position * pixelScale) / viewportSize;
    float2 ndc = float2(screen.x, 1.0 - screen.y) * 2.0 - 1.0;
    float aspect = viewportSize.x / viewportSize.y;
    ndc.x *= aspect;
    float3 homogeneous = float3(ndc, 1.0);
    float2 uv = float2(dot(inverseModelRowX, homogeneous),
                      dot(inverseModelRowY, homogeneous));
    uv.x /= aspect;
    uv = uv * 0.5 * 0.2 * max(viewportSize.x, viewportSize.y) / 720.0 + 0.5;
    float4 result = float4(0.0);
    for (int index = 0; index < 90; ++index) {
        if (viewportSize.x < viewportSize.y && index > 40) break;
        if (abs(viewportSize.x - viewportSize.y) < 0.001 && index > 70) break;
        float seed = float(index);
        if (viewportSize.x / viewportSize.y <= 4.0 / 3.0) seed *= 32.0;
        float4 copy = scatterCopy(seed, uv);
        result += copy * (1.0 - result.a);
    }
    result *= smoothstep(1.0, 0.95, uv.y);
    result *= smoothstep(0.0, 0.05 * viewportSize.y / viewportSize.x, uv.x);
    result *= smoothstep(1.0, 1.0 - 0.05 * viewportSize.y / viewportSize.x, uv.x);
    return half4(result);
}
