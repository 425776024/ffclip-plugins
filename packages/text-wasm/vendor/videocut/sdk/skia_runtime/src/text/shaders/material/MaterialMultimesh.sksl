
    uniform shader inputTexture;
    uniform shader historyTexture;
    uniform shader colorTexture;
    uniform shader defaultColorTexture;
    uniform float2 textureSize;
    uniform float2 colorSize;
    uniform float2 defaultColorSize;
    uniform float passIndex;
    uniform float weaken;
    uniform float opacity;
    uniform float2 translation;
    uniform float2 scale;
    uniform float4 characterColor;

    float2 hueLightness(float3 color) {
      float lo = min(color.r, min(color.g, color.b));
      float hi = max(color.r, max(color.g, color.b));
      float hue = 0.0;
      if (hi > lo) {
        float delta = hi - lo;
        if (color.r == hi) hue = (color.g - color.b) / delta;
        else if (color.g == hi) hue = 2.0 + (color.b - color.r) / delta;
        else hue = 4.0 + (color.r - color.g) / delta;
        if (hue < 0.0) hue += 6.0;
        hue /= 6.0;
      }
      return float2(hue, (hi + lo) * 0.5);
    }
    half4 main(float2 position) {
      float4 source = float4(inputTexture.eval(position));
      float4 history = float4(historyTexture.eval(position));
      if (passIndex < 0.5) {
        float retained = history.a * weaken;
        retained *= step(0.1, retained);
        return half4(clamp(source.a + retained, 0.0, 1.0));
      }
      float2 uv = float2(position.x / textureSize.x,
                         1.0 - position.y / textureSize.y);
      uv = (uv - 0.5 + float2(-translation.x, translation.y)) / scale + 0.5;
      float2 hsl = hueLightness(characterColor.rgb);
      float4 color = float4(colorTexture.eval(float2(hsl.x, 1.0 - uv.x) * colorSize));
      float4 defaultColor = float4(defaultColorTexture.eval(
          float2(uv.x, 0.0) * defaultColorSize));
      color.rgb = mix(color.rgb, defaultColor.rgb, hsl.y * 2.0 - 1.0);
      float4 trail = color * history.a;
      return half4(clamp(trail * (1.0 - source.a) + source, 0.0, 1.0) * opacity);
    }
  